  {{!-- ================Area pricipal de trabajo================ --}}

  <section id="contenedorPrincipal">
    <div id="header">
      <div class="contenedor-header row d-flex align-items-center">
        {{!-- <div class="col">
          <div>
            <img src="img/logo.png" alt="" width="120px" class="rounded">
          </div>
        </div> --}}
        <div class="col">
          {{!-- <span>Perfil administrador</span> --}}
        </div>
        <div class="col text-end">
          {{!-- <span><a href="/" class="btn-salir"><i class="bi bi-geo-alt-fill"></i>&nbsp
              Interval</a></span> --}}
        </div>
      </div>
    </div>

    {{!-- Area reactiva administrador --}}
    <div class="row">
      <div class="col">
        <div id="contenedorReactivo" class="flex-colum text-center">
          {{!-- Aqui se reenderiza todo --}}
          {{!-- <span>BienVenidos</span> --}}
          <img src="/img/logo_AGL.png" alt="" width="30%">
        </div>

        {{!-- ==================== TEMPLATES ==================== --}}
        {{!-- Template: Vista de Clientes --}}
        <template id="templateContenedorClientes">
          <span class="clientes"></span>
          <div id="clientes" class="p-4 container">
            {{!-- Card de Clientes --}}
            <div class="card shadow-sm border-0">
              <div class="card-body p-0">
                {{!-- Título y buscador dentro de la card --}}
                <div class="p-4 pb-3 border-bottom">
                  <div class="d-flex justify-content-start align-items-center flex-wrap gap-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Listado de Clientes</h5>
                  </div>
                  <div class="d-flex justify-content-end align-items-center flex-wrap gap-3">
                    {{!-- Buscador --}}
                    <div class="input-group input-group-sm" style="max-width: 320px;">
                      <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                      </span>
                      <input type="text" class="form-control form-control-sm"
                        id="inputBuscarCertificado" placeholder="Buscar por documento o nombre...">
                    </div>
                    <div>
                      <button type="button" class="btn btn-primario btn-guardar-registro" data-bs-toggle="modal" data-bs-target="#modalRegistro">Añadir Cliente</button>
                    </div>
                  </div>
                </div>

                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-center">
                      <tr>
                        <th class="ps-3">ID</th>
                        <th class="">DOCUMENTO</th>
                        <th class="">NOMBRES</th>
                        <th class="">TELEFONO</th>
                        {{!-- <th class="">ESTADO</th> --}}
                        <th class="">OPCIONES</th>
                      </tr>
                    </thead>
                    <tbody id="contenedorTablaCliente" class="text-center">
                      {{!-- Aqui se reendiriza los datos dinamicamente --}}
                    </tbody>

                    <template id="templateTablaClientes">
                      <tr>
                        <td class="id-persona"></td>
                        <td class="documento-persona"></td>
                        <td class="nombres-persona"></td>
                        <td class="telefono-persona"></td>
                        {{!-- <td id="contenedorEstadoListar" class="text-center"></td> --}}
                        <td>
                          <div class="d-flex justify-content-center">
                            <span id="verCertificados" class="bi bi-file-earmark-pdf text-danger" title="Ver certificados del cliente"></span>
                            <span id="editarPersona" class="bi bi-pen-fill me-3 ms-3 text-secondary" data-bs-toggle="modal" data-bs-target="#modalEditarPersona"></span>
                            <span id="eliminarPersona" class="bi bi-trash3-fill text-danger"></span>
                          </div>
                        </td>
                      </tr>
                    </template>
                  </table>
                  <div id="busquedaVacia" class="text-center text-muted py-3 d-none"></div>
                </div>

                {{!-- Info, Selector de registros y Paginación --}}
                <div class="p-3 border-top">
                  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                      <div class="small text-muted" id="infoPaginacion">
                        {{!-- Se llena dinámicamente --}}
                      </div>

                      <div class="d-flex align-items-center gap-2">
                        <label class="small text-muted mb-0">Mostrar:</label>
                        <select id="selectRegistrosPorPagina"
                          class="form-select form-select-sm">
                          <option value="3">3</option>
                          <option value="5" selected>5</option>
                          <option value="10">10</option>
                          <option value="20">20</option>
                        </select>
                      </div>
                    </div>

                    <nav aria-label="Paginación de clientes">
                      <ul class="pagination pagination-sm mb-0" id="paginacionClientes">
                        {{!-- Se llena dinámicamente con JavaScript --}}
                      </ul>
                    </nav>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </template>
        <template id="templateContenedorArchivos">
          <div class="bg-danger">
            <span class="mis-archivos"></span>
          </div>
        </template>
        {{!-- <template id="templateContenedorNotificacion">
          <div class="bg-success">
            <span class="notificacion"></span>
          </div>
        </template> --}}
        <template id="templateContenedorConfiguracion">
          <div class="bg-warning">
            <span class="configuracion"></span>
          </div>
        </template>
        <template id="templateContenedorCerrar">
          
        </template>
      </div>
    </div>
  </section>

  {{!-- ==================== Modal Registrar Persona ==================== --}}
  <div class="modal fade modal-personalizado" id="modalRegistro" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalRegistroLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">

        <div class="modal-header border-0 pb-0">
          <div>
            <h5 class="modal-title" id="modalRegistroLabel">Registrar nuevo Cliente</h5>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="input-style mb-3">
            <input id="documento" type="text" inputmode="numeric" placeholder=" ">
            <label for="documento">
              <i class="bi bi-window-dock me-1"></i>N° Documento
            </label>
            <span class="input-style-error">Ingrese el número de documento.</span>
          </div>
          <div class="input-style mb-3">
            <input id="nombres" type="text" placeholder=" ">
            <label for="nombres">
              <i class="bi bi-person me-1"></i>Nombres
            </label>
            <span class="input-style-error">Ingrese los nombres.</span>
          </div>
          <div class="input-style mb-3">
            <input id="apellidos" type="text" placeholder=" ">
            <label for="apellidos">
              <i class="bi bi-person me-1"></i>Apellidos
            </label>
            <span class="input-style-error">Ingrese los apellidos.</span>
          </div>

          <div class="input-style mb-3">
            <input id="telefono" type="tel" placeholder=" ">
            <label for="telefono">
              <i class="bi bi-telephone me-1"></i>Teléfono
            </label>
            <span class="input-style-error">Ingrese el número telefónico.</span>
          </div>

          {{!-- <div class="input-style mb-3">
            <input id="correoRegistro" type="email" placeholder=" ">
            <label for="correoRegistro">
              <i class="bi bi-envelope me-1"></i>Correo electrónico (usuario)
            </label>
            <span class="input-style-error">Ingrese un correo válido.</span>
          </div>

          <div class="input-style mb-2">
            <input id="passwordRegistro" type="password" placeholder=" ">
            <label for="passwordRegistro">
              <i class="bi bi-lock me-1"></i>Contraseña
            </label>
            <span class="input-style-error">Ingrese una contraseña.</span>
          </div> --}}
        </div>

        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-cancelar me-2" data-bs-dismiss="modal">Cancelar</button>
          <button id="btnAñadirCliente" type="button" class="btn btn-primario btn-guardar-registro">
            <i class="bi bi-check2 me-2"></i>Registrar
          </button>
        </div>

      </div>
    </div>
  </div>

  {{!-- ==================== Modal Listar Certificados ==================== --}}
  <div class="modal fade" id="modalListarCertificado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="modalCertificadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <!-- HEADER -->
        <div class="modal-header">
          <h5 class="modal-title" id="modalCertificadoLabel">CERTIFICADOS</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <!-- BODY -->
        <div class="modal-body">
          <!-- INFORMACIÓN DEL CLIENTE -->
          <div class="mb-3">
            <div class="d-flex mb-2">
              <span class="fw-bold"> DNI/RUC: &nbsp</span>
              <span class="doc-cliente-certificado"></span>
            </div>
            <div class="d-flex">
              <span class="fw-bold">Nombres/Empresa: &nbsp</span>
              <span class="nombre-cliente-certificado"></span>
            </div>
          </div>
          <!-- BOTÓN AGREGAR -->
          <div class="d-flex justify-content-end mb-3">
            <span id="btnAgregarCertificado" class="btn btn-header bi bi-file-earmark-plus">Añadir certificado</span>
          </div>
          <!-- INPUT PDF -->
          <div id="contenedorAgregarCertificado" class="card p-3 mb-3 d-none">
            <div class="input-style mb-3">
              <input id="codigoCertificado" type="text" inputmode="numeric" placeholder=" ">
              <label for="codigoCertificado">
                <i class="bi bi-window-dock me-1"></i>Código Certificado
              </label>
              <span class="input-style-error">Ingrese el código del certificado.</span>
            </div>
            <div class="input-style mb-3">
              <input id="tituloCertificado" type="text" placeholder=" ">
              <label for="tituloCertificado">
                <i class="bi bi-file-earmark-plus me-1"></i>Título
              </label>
              <span class="input-style-error">Ingrese el título del certificado.</span>
            </div>
            {{!-- <div class="input-style mb-2">
              <textarea id="descripcionCertificado" placeholder=" "></textarea>
              <label for="descripcionCertificado">
                <i class="bi bi-chat-left-text me-1"></i>Descripción
              </label>
              <span class="input-style-error">Ingrese una descripción.</span>
            </div> --}}
            <div class="mb-3">
              <label class="form-label">Archivo PDF</label>
              <input type="file" id="archivoCertificado" class="form-control form-control-sm" accept="application/pdf">
            </div>
            <div class="text-end">
              <button id="btnCancelarAgregarCertificado" type="button" class="btn btn-cancelar me-2">Cancelar</button>
              <button id="btnGuardarCertificado" type="button" class="btn btn-primario btn-guardar-registro">Guardar</button>
            </div>
          </div>
          <!-- TABLA -->
          <div class="card table-responsive-sm p-2 mt-3">
            <table id="tbCertificados" class="table table-sm table-hover">
              <thead>
                <tr>
                  <th>CÓDIGO</th>
                  <th>TÍTULO</th>
                  <th>ESTADO</th>
                  <th class="text-center">OPCIONES</th>
                </tr>
              </thead>
              <tbody id="contenedorCert">
                {{!-- Se reenderiza dianmicamente --}}
              </tbody>
            </table>
            <!-- TEMPLATE -->
            <template id="templateCert">
              <tr>
                <td>
                  <span class="codigo"></span>
                </td>
                <td>
                  <span class="titulo"></span>
                </td>
                <td>
                  <span class="estado"></span>
                </td>
                <td>
                  <div class="d-flex justify-content-center">
                    <!-- VER PDF -->
                    <span class="btn btn-sm btn-ver-certificado" title="Ver certificado">
                      <i class="bi bi-file-pdf text-danger"></i>
                    </span>
                    <!-- EDITAR -->
                    {{!-- <span class="btn btn-sm btn-editar-certificado"title="Editar">
                      <i class="bi bi-pencil-fill text-secondary"></i>
                    </span> --}}
                    <!-- ELIMINAR -->
                    <span class="btn btn-sm btn-eliminar-certificado" title="Eliminar certificado">
                      <i class="bi bi-trash-fill text-danger"></i>
                    </span>
                  </div>
                </td>
              </tr>
            </template>
            <div id="certVacio" class="text-center"></div>
          </div>
        </div>
        <!-- FOOTER -->
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-cancelar" data-bs-dismiss="modal">
            Cerrar
          </button>
        </div>

      </div>

    </div>

  </div>

  {{!-- ==================== Modal Editar Persona ==================== --}}
  <div class="modal fade" id="modalEditarPersona" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content p-3">

        <div class="modal-header">
          <div>
            <h5 class="modal-title" id="modalEditarLabel">Actualizar Datos</h5>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="input-style mb-3">
            <input id="editarDocumento" type="text" inputmode="numeric" placeholder=" ">
            <label for="editarDocumento">
              <i class="bi bi-window-dock me-1"></i>N° Documento
            </label>
            <span class="input-style-error">Ingrese el número de documento.</span>
          </div>
          <div class="input-style mb-3">
            <input id="editarNombres" type="text" placeholder=" ">
            <label for="editarNombres">
              <i class="bi bi-person me-1"></i>Nombres
            </label>
            <span class="input-style-error">Ingrese los nombres.</span>
          </div>
          <div class="input-style mb-3">
            <input id="editarApellidos" type="text" placeholder=" ">
            <label for="editarApellidos">
              <i class="bi bi-person me-1"></i>Apellidos
            </label>
            <span class="input-style-error">Ingrese los apellidos.</span>
          </div>

          <div class="input-style mb-3">
            <input id="editarTelefono" type="tel" placeholder=" ">
            <label for="editarTelefono">
              <i class="bi bi-telephone me-1"></i>Teléfono
            </label>
            <span class="input-style-error">Ingrese el número telefónico.</span>
          </div>
          {{!-- <div>
            <span for="contenedorEstado">Estado</span>
          </div> --}}
          <div id="contenedorEstado" class="mb-3"></div>
        </div>

        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-cancelar me-2" data-bs-dismiss="modal">Cancelar</button>
          <button id="actualizaPersona" type="button" class="btn btn-primario">
            <i class="bi bi-check2 me-2"></i>Actualizar
          </button>
        </div>

      </div>
    </div>
  </div>

  {{!-- ==================== MODAL: CERRAR SESIÓN  ==================== --}}
  <div class="modal fade" id="modalCerrarSesion" tabindex="-1" aria-labelledby="modalCerrarSesionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content border-0 shadow">
        {{!-- Cuerpo del modal --}}
        <div class="modal-body text-center p-4">
          {{!-- Icono --}}
          <div class="mb-3">
            <i class="bi bi-box-arrow-right modal-icono-cerrar"></i>
          </div>

          {{!-- Título --}}
          <h6 class="fw-bold mb-1" id="modalCerrarSesionLabel">Cerrar Sesión</h6>

          {{!-- Subtítulo --}}
          <p class="mb-4 modal-subtitulo-cerrar">¿Desea salir del sistema?</p>

          {{!-- Botones --}}
          <div class="d-flex justify-content-center gap-2">
            <button type="button" class="btn btn-link btn-sm px-3 py-2 text-decoration-none btn-cancelar-modal" data-bs-dismiss="modal">
              Cancelar
            </button>
            <button type="button" class="btn btn-cancelar btn-sm px-3 py-2" id="btnConfirmarCerrarSesion">
              Salir
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast de notificaciones -->
  <div id="toastContainer" class="toast-container-custom" aria-live="polite" aria-atomic="true">
    <div id="toastCertificado" class="toast-personalizado" role="alert">
      <i id="toastIcono" class="bi toast-icono"></i>
      <div class="toast-contenido">
        <p id="toastTitulo" class="toast-titulo mb-0"></p>
        <p id="toastMensaje" class="toast-mensaje mb-0"></p>
      </div>
      <button type="button" id="toastCerrar" class="toast-cerrar" aria-label="Cerrar notificación">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
  </div>
</div>
